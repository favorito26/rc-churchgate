{
  "name": "rc-churchgate",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:api": "echo \"API is deployed via Wrangler; no build step required\"",
    "lint": "npm run lint --workspace=web"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
